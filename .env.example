# Copy this file to .env and fill in real values. Never commit .env.

# Flask
SECRET_KEY=change-this-to-a-long-random-string
FLASK_ENV=development

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=ecoquest_user
DB_PASSWORD=change-this-password
DB_NAME=ecoquest

# Test database (used only by the automated test suite)
TEST_DB_NAME=ecoquest_test
